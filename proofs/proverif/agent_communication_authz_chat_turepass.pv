(*
  SAGA AGENT COMMUNICATION: IMPLEMENTATION MISMATCH CONTROL
  AUTHOR: [REDACTED]

  Stated Assumption #1: X25519 used; asymm keys can be used for signing *and* dh
*)

set simpEqAll = false.
set selFun = Nounifset.
set redundancyElim = best.
set redundantHypElim = true.
set simplifyProcess = true.
set stopTerm = false.

free c: channel.
free prov_ca: channel.
free prov_b: channel.
free a: channel. (* channel for publishing materials to the attacker *)
free p: channel [private].

(* Authenticated and confidential chat transport abstraction. *)
free tls_chat: channel [private].

type key.

fun senc(key, bitstring): bitstring.
reduc forall m: bitstring, k: key; sdec(k, senc(k,m)) = m.

type skey.
type pkey.

fun pk(skey): pkey.

(* Digital signatures *)

fun okay():bitstring.
fun rb(pkey): bitstring [data].
fun sign(skey, bitstring): bitstring.
reduc forall m: bitstring, sk: skey; checksign(pk(sk), m, sign(sk, m)) = okay.

(* Diffie-Hellman *)
fun dh(pkey, skey): key.
equation forall a_sk: skey, b_sk: skey; dh(pk(a_sk), b_sk) = dh(pk(b_sk), a_sk). 

(* The concat functions *)
fun concat1(bitstring, pkey): bitstring [data].
fun concat2(bitstring, bitstring, pkey, pkey, pkey): bitstring [data].
fun concat3(bitstring, bitstring, pkey, pkey, bitstring): bitstring [data].

(* Process Definitions *)

event EndAuthA(bitstring, bitstring, pkey).
event EndProviderAuthA(bitstring, bitstring, pkey).

event EndAuthB(bitstring, bitstring, pkey).
event EndProviderAuthB(bitstring, bitstring, pkey).

event EndAgentAuthA(bitstring, bitstring, key).
event EndAgentAuthB(bitstring, bitstring, key).

(* The Stage 1 Accept event means B received and verified A's token. *)
event TokenIssue(bitstring, bitstring, bitstring).
event Accept(bitstring, bitstring, bitstring).

(* Authorization and Control Events *)
event SpecIntendedDeny(bitstring, bitstring).
event ProviderRelease(bitstring, bitstring).
event TokenReceive(bitstring, bitstring, bitstring).
event ChatSend(bitstring, bitstring, bitstring, bitstring).
event ChatAccept(bitstring, bitstring, bitstring, bitstring).

table ProviderAuthorized(bitstring, bitstring).
table ReceiverAuthorized(bitstring, bitstring).
table ProviderReleased(bitstring, bitstring).
table ActiveToken(bitstring, bitstring, bitstring, pkey).
table ScenarioSpecDeny(bitstring, bitstring).
table ScenarioImplAllow(bitstring, bitstring).

event start().

(* 实体与密钥声明 *)
free ED_A: bitstring [private].
free aid_A: bitstring [private].
free uid_A: bitstring [private].
free SOTK1_A: skey [private].
free SAC_A: skey [private].

free ED_B: bitstring [private].
free aid_B: bitstring [private].
free uid_B: bitstring [private].
free SOTK1_B: skey [private].
free SAC_B: skey [private].

(* --- 固定场景假设；状态表不会执行 Python matcher --- *)
free BuggyPolicy: bitstring.
(* ----------------------------------- *)


let PeerA(SK_A: skey, PK_A: pkey, PK_Prov: pkey, PK_CA: pkey, PK_B: pkey) =

  phase 1;
  let PAC_A = pk(SAC_A) in
  let OTK1_A = pk(SOTK1_A) in
  let OTK1_A_sig = sign(SK_A, rb(OTK1_A)) in

  phase 2;
  let sigma_A_sig = sign(SK_A, concat2(aid_A, ED_A, PK_A, PAC_A, PK_Prov)) in
  out(c, (aid_A, OTK1_A_sig, OTK1_A, sigma_A_sig, PAC_A, ED_A));

  in(c, sigma_Prov_sig_A: bitstring);
  if checksign(PK_Prov, concat3(aid_A, ED_A, PK_A, PAC_A, sigma_A_sig), sigma_Prov_sig_A) = okay then

  event EndAuthA(ED_A, aid_A, OTK1_A);

  phase 5;
  in(c, (aid_B_in: bitstring, Cert_B: bitstring, ED_B_in: bitstring, PAC_B: pkey, sigma_B_sig: bitstring, sigma_Prov_sig_B: bitstring));

  if checksign(PK_Prov, concat3(aid_B_in, ED_B_in, PK_B, PAC_B, sigma_B_sig), sigma_Prov_sig_B) = okay then

  get ProviderReleased(=aid_A, =aid_B_in) in

  (* 接收方读取预置的实现侧决策；此处不运行 Python matcher。 *)
  get ScenarioImplAllow(=BuggyPolicy, =aid_B_in) in
      let DH_A = dh(PAC_B, SOTK1_A) in
      
      (* 动态生成属于本次会话的 Ephemeral Token，完美实现会话隔离 *)
      new token: bitstring; 
      
      let token_sig = sign(SK_A, token) in
      event EndAgentAuthA(token, ED_A, DH_A);
      
      let token_enc = senc(DH_A, token) in
      insert ActiveToken(aid_A, aid_B_in, token_enc, PAC_B);
      event TokenIssue(aid_A, aid_B_in, token_enc);
      out(c, (token_sig, token_enc));

  (* One application message follows an issued and PAC-bound token. *)
  phase 6;
  in(tls_chat, (sender: bitstring, sender_pac: pkey,
                presented_token: bitstring, chat_msg: bitstring));
  if sender = aid_B then
  get ActiveToken(=aid_A, =sender, =presented_token, =sender_pac) in
  event ChatAccept(aid_A, sender, presented_token, chat_msg);

  0.

let PeerB(SK_B: skey, PK_B: pkey, PK_Prov: pkey, PK_CA: pkey, PK_A: pkey) =

  phase 3;
  let PAC_B = pk(SAC_B) in
  let OTK1_B = pk(SOTK1_B) in
  let OTK1_B_sig = sign(SK_B, rb(OTK1_B)) in

  phase 4;
  let sigma_B_sig = sign(SK_B, concat2(aid_B, ED_B, PK_B, PAC_B, PK_Prov)) in
  out(c, (aid_B, OTK1_B_sig, OTK1_B, sigma_B_sig, PAC_B, ED_B));

  in(c, sigma_Prov_sig_B: bitstring);
  if checksign(PK_Prov, concat3(aid_B, ED_B, PK_B, PAC_B, sigma_B_sig), sigma_Prov_sig_B) = okay then

  event EndAuthB(ED_B, aid_B, OTK1_B);

  phase 5;
  in(prov_b, (Cert_A: bitstring, Cert_B:bitstring, aid_A_in: bitstring, OTK1_A_sig: bitstring, OTK1_A: pkey, sigma_A_sig: bitstring, PAC_A: pkey, ED_A_in: bitstring));

  if checksign(PK_CA, concat1(aid_A_in, PK_A), Cert_A) = okay then
  if checksign(PK_A, rb(OTK1_A), OTK1_A_sig) = okay then
  if checksign(PK_A, concat2(aid_A_in, ED_A_in, PK_A, PAC_A, PK_Prov), sigma_A_sig) = okay then

  let DH_B = dh(OTK1_A, SAC_B) in
  out(c, (aid_B, Cert_B, ED_B, PAC_B, sigma_B_sig, sigma_Prov_sig_B));

  phase 6;
  in(c, (token_sig:bitstring, token_enc:bitstring));

  let token = sdec(DH_B, token_enc) in
  if checksign(PK_A, token, token_sig) = okay then
  event EndAgentAuthB(token, ED_A_in, DH_B);

  event TokenReceive(aid_A_in, aid_B, token_enc);
  event Accept(aid_A_in, aid_B, token);

  new chat_msg: bitstring;
  event ChatSend(aid_A_in, aid_B, token_enc, chat_msg);
  out(tls_chat, (aid_B, PAC_B, token_enc, chat_msg));

  0.

let CA(SK_CA: skey, PK_CA: pkey, PK_A: pkey, PK_B: pkey, PK_Prov: pkey) =
  phase 1;
  let Cert_A = sign(SK_CA, concat1(aid_A, PK_A)) in
  out(prov_ca, (Cert_A, aid_A, PK_A));

  phase 2;
  phase 3;
  let Cert_B = sign(SK_CA, concat1(aid_B, PK_B)) in
  out(prov_ca, (Cert_B, aid_B, PK_B));
  phase 4;
  0.

let Provider(SK_Prov: skey, PK_Prov: pkey, PK_CA: pkey) =
  phase 2;
  in(prov_ca, (Cert_A: bitstring, aid_r1:bitstring, PK_A: pkey));
  if aid_r1 = aid_A then

  in(c, (aid_A_in: bitstring, OTK1_A_sig: bitstring, OTK1_A: pkey, sigma_A_sig: bitstring, PAC_A: pkey, ED_A_in: bitstring));

  if checksign(PK_CA, concat1(aid_A_in, PK_A), Cert_A) = okay then
  if checksign(PK_A, rb(OTK1_A), OTK1_A_sig) = okay then
  if checksign(PK_A, concat2(aid_A_in, ED_A_in, PK_A, PAC_A, PK_Prov), sigma_A_sig) = okay then
  let sigma_Prov_sig_A = sign(SK_Prov, concat3(aid_A_in, ED_A_in, PK_A, PAC_A, sigma_A_sig)) in

  event EndProviderAuthA(ED_A_in, aid_A_in, OTK1_A);
  out(c, sigma_Prov_sig_A);

  phase 3;
  phase 4;
  in(prov_ca, (Cert_B: bitstring, aid_r2:bitstring, PK_B: pkey));
  if aid_r2 = aid_B then

  in(c, (aid_B_in: bitstring, OTK1_B_sig: bitstring, OTK1_B: pkey, sigma_B_sig: bitstring, PAC_B: pkey, ED_B_in: bitstring));

  if checksign(PK_CA, concat1(aid_B_in, PK_B), Cert_B) = okay then
  if checksign(PK_B, rb(OTK1_B), OTK1_B_sig) = okay then
  if checksign(PK_B, concat2(aid_B_in, ED_B_in, PK_B, PAC_B, PK_Prov), sigma_B_sig) = okay then
  let sigma_Prov_sig_B = sign(SK_Prov, concat3(aid_B_in, ED_B_in, PK_B, PAC_B, sigma_B_sig)) in

  event EndProviderAuthB(ED_B_in, aid_B_in, OTK1_B);
  out(c, sigma_Prov_sig_B);

  phase 5;

  (* 1. 读取预置的规范侧拒绝决策。 *)
  get ScenarioSpecDeny(=BuggyPolicy, =aid_B_in) in
      event SpecIntendedDeny(aid_B_in, aid_A);

  (* 2. 读取预置的实现侧允许决策；此处不运行 Python matcher。 *)
  get ScenarioImplAllow(=BuggyPolicy, =aid_B_in) in
      out(prov_b, (Cert_A, Cert_B, aid_A, OTK1_A_sig, OTK1_A, sigma_A_sig, PAC_A, ED_A));
      event ProviderRelease(aid_A, aid_B_in);
      insert ProviderReleased(aid_A, aid_B_in);

  0.

(* 1. 保留你的出处证明：证明底层的 Token 签发与密码学验证逻辑没被破坏 *)
query receiver: bitstring, sender: bitstring, tok: bitstring, msg: bitstring;
    event(ChatAccept(receiver, sender, tok, msg)) ==> event(TokenIssue(receiver, sender, tok)).

(* 2. 端到端越权查询：触发攻击的最终状态是否可达？ *)
query receiver: bitstring, sender: bitstring, tok: bitstring, msg: bitstring;
    event(ChatAccept(receiver, sender, tok, msg)).
    
  process
  new SK_CA: skey; let PK_CA = pk(SK_CA) in
  new SK_Prov: skey; let PK_Prov = pk(SK_Prov) in
  new SK_A: skey; let PK_A = pk(SK_A) in
  new SK_B: skey; let PK_B = pk(SK_B) in
  out(a, (PK_A, PK_B, PK_Prov, PK_CA)); 
  event start();

  (* Matcher decisions are fixed scenario assumptions, not Python execution. *)
  insert ScenarioSpecDeny(BuggyPolicy, aid_B);
  insert ScenarioImplAllow(BuggyPolicy, aid_B);
  ( (!CA(SK_CA, PK_CA, PK_A, PK_B, PK_Prov)) |
    (!Provider(SK_Prov, PK_Prov, PK_CA)) |
    (!PeerA(SK_A, PK_A, PK_Prov, PK_CA, PK_B)) |
    (!PeerB(SK_B, PK_B, PK_Prov, PK_CA, PK_A)))
